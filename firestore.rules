rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Legacy root collections (locked down: read/write denied; data migrated to /trips/{tripId}/...)
    //   - /members/{memberId}
    //   - /groups/{groupId}
    //   - /settings/{docId}
    //   - /itineraries/{itineraryId}
    //   - /rollcalls/{rollcallId}
    //
    // Collection: members (under /trips/{tripId}/members/{memberId})
    // Document ID: memberId
    // Fields:
    //   - id: string (optional on legacy partial updates, <= 128 chars)
    //   - name: string (required, 1..100 chars)
    //   - dietaryHabits: string | null (optional, <= 100 chars)
    //   - phone: string | null (optional, <= 30 chars)
    //   - passportInfo: string | null (optional, <= 200 chars)
    //   - notes: string | null (optional, <= 2000 chars)
    //   - groupId: string | null (optional, <= 100 chars)
    //   - tags: list | null (optional, <= 50 items)
    //   - outboundFlight: string | null (optional, <= 100 chars)
    //   - outboundTime: string | null (optional, <= 100 chars)
    //   - returnFlight: string | null (optional, <= 100 chars)
    //   - returnTime: string | null (optional, <= 100 chars)
    //   - isLeader: bool | null (optional)
    //   - gender: string | null (optional, <= 100 chars)
    //   - tripDays: number | null (optional, 0..1000)
    //   - carNumber: string | null (optional, <= 100 chars)
    //
    // Collection: groups (under /trips/{tripId}/groups/{groupId})
    // Document ID: groupId
    // Fields:
    //   - id: string (optional on legacy partial updates, <= 128 chars)
    //   - name: string (required, 1..100 chars)
    //
    // Collection: settings (under /trips/{tripId}/settings/{docId})
    // Document ID: docId (e.g., tripSettings)
    // Fields:
    //   - startDate: string (optional, <= 30 chars)
    //   - endDate: string (optional, <= 30 chars)
    //   - officialStartDate: string | null (optional, <= 30 chars)
    //   - dailyAbsences: map | null (optional, <= 500 entries)
    //   - adminEmails: list | null (locked down; allowed on existing legacy docs only, immutable on update)
    //
    // Collection: itineraries (under /trips/{tripId}/itineraries/{itineraryId})
    // Document ID: itineraryId
    // Fields:
    //   - id: string (optional on legacy partial updates, <= 128 chars)
    //   - title: string (required, 1..200 chars)
    //   - startTime: timestamp (required)
    //   - endTime: timestamp | null (optional)
    //   - type: string (required, enum: attraction, dining, transit, logistics, accommodation)
    //   - location: map | null (optional, { address?: string, navLink?: string })
    //   - notes: string | null (optional, <= 2000 chars)
    //   - isMain: bool (optional)
    //   - assignedMemberIds: list | null (optional, <= 1000 items)
    //   - excludedMemberIds: list | null (optional, <= 1000 items)
    //   - dayIndex: number | null (optional, -1..365)
    //   - vehicleAssignments: map | null (optional, <= 1000 entries)
    //   - isMultiVehicle: bool | null (optional)
    //   - roomAssignments: map | null (optional, <= 1000 entries)
    //   - isMultiRoom: bool | null (optional)
    //   - rooms: list | null (optional, <= 200 items)
    //   - seatingConfig: map | null (optional, { columns?: number, rows?: number })
    //   - seatingAssignments: map | null (optional, <= 1000 entries)
    //   - seatingNotes: map | null (optional, <= 1000 entries)
    //   - groupAssignments: map | null (optional, legacy, <= 1000 entries)
    //   - isGrouped: bool | null (optional, legacy)
    //   - groups: list | null (optional, legacy, <= 200 items)
    //   - accommodationDetail: string | null (optional, legacy, <= 1000 chars)
    //
    // Collection: rollcalls (under /trips/{tripId}/rollcalls/{rollcallId})
    // Document ID: rollcallId (e.g., rc_{itineraryId})
    // Fields:
    //   - id: string (optional, <= 128 chars)
    //   - itineraryId: string (required, 1..128 chars)
    //   - timestamp: timestamp (required)
    //   - statusMap: map (required, <= 1000 entries)
    //
    // Document: test/connection
    //   - Read-only connection test document for authenticated clients
    //
    // Collection: tripInvites
    // Document ID: inviteCode (12..24 chars; get-only capability lookup, list disabled)
    // Fields:
    //   - tripId: string (required, 1..128 chars)
    //   - tripName: string (required, 1..120 chars)
    //   - ownerId: string (required, 1..128 chars)
    //   - createdAt: string (required, 1..40 chars)
    //
    // Collection: trips
    // Document ID: tripId
    // Fields:
    //   - id: string (optional, <= 128 chars)
    //   - name: string (required, 1..120 chars)
    //   - description: string | null (optional, <= 500 chars)
    //   - startDate: string (required, 1..40 chars)
    //   - endDate: string (required, 1..40 chars)
    //   - ownerId: string (required, immutable, 1..128 chars)
    //   - ownerEmail: string (required, immutable, 1..200 chars)
    //   - ownerName: string | null (optional, <= 120 chars)
    //   - memberUids: list (required, <= 500 items)
    //   - collaboratorEmails: list (required, <= 500 items)
    //   - inviteCode: string (required, 4..24 chars; >= 12 on new creates/rotations)
    //   - lastJoinProof: string | null (optional, <= 200 chars; "<inviteCode>:<uid>" proof on invite join)
    //   - createdAt: string (required, immutable, 1..40 chars)
    //   - updatedAt: string | null (optional, <= 40 chars)
    //
    // Subcollections under /trips/{tripId}:
    //   - /trips/{tripId}/members/{memberId}
    //   - /trips/{tripId}/groups/{groupId}
    //   - /trips/{tripId}/settings/{docId}
    //   - /trips/{tripId}/itineraries/{itineraryId}
    //   - /trips/{tripId}/rollcalls/{rollcallId}
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null &&
             (('email_verified' in request.auth.token && request.auth.token.email_verified == true) ||
              ('admin' in request.auth.token && request.auth.token.admin == true));
    }

    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function isValidOptionalString(data, field, maxLen) {
      return !(field in data) ||
             data[field] == null ||
             (data[field] is string && data[field].size() <= maxLen);
    }

    function isValidOptionalBool(data, field) {
      return !(field in data) ||
             data[field] == null ||
             data[field] is bool;
    }

    function isValidOptionalList(data, field, maxSize) {
      return !(field in data) ||
             data[field] == null ||
             (data[field] is list && data[field].size() <= maxSize);
    }

    function isValidOptionalMap(data, field, maxSize) {
      return !(field in data) ||
             data[field] == null ||
             (data[field] is map && data[field].size() <= maxSize);
    }

    function isTripCollaboratorData(tripData) {
      return request.auth.uid == tripData.ownerId ||
             request.auth.uid in tripData.memberUids ||
             ('email' in request.auth.token &&
              request.auth.token.email is string &&
              (request.auth.token.email in tripData.collaboratorEmails ||
               request.auth.token.email.lower() in tripData.collaboratorEmails));
    }

    function isTripDocCollaborator(tripDocSnap) {
      return tripDocSnap != null && isTripCollaboratorData(tripDocSnap.data);
    }

    function isOwnerUpdatingTrip(oldData, newData) {
      return oldData.ownerId == request.auth.uid &&
             oldData.ownerId in newData.memberUids &&
             (newData.inviteCode == oldData.inviteCode || newData.inviteCode.size() >= 12) &&
             (!('lastJoinProof' in newData) ||
              ('lastJoinProof' in oldData && newData.lastJoinProof == oldData.lastJoinProof));
    }

    function isCollaboratorEditingTripMetadata(oldData, newData) {
      return isTripCollaboratorData(oldData) &&
             oldData.ownerId != request.auth.uid &&
             newData.diff(oldData).affectedKeys().hasOnly(['name', 'description', 'startDate', 'endDate', 'updatedAt']);
    }

    function isCollaboratorLeavingTrip(oldData, newData) {
      return isTripCollaboratorData(oldData) &&
             oldData.ownerId != request.auth.uid &&
             newData.diff(oldData).affectedKeys().hasOnly(['memberUids', 'collaboratorEmails', 'updatedAt']) &&
             oldData.ownerId in newData.memberUids &&
             !(request.auth.uid in newData.memberUids) &&
             oldData.memberUids.hasAll(newData.memberUids) &&
             newData.memberUids.size() >= oldData.memberUids.size() - 1 &&
             (!newData.diff(oldData).affectedKeys().hasAny(['collaboratorEmails']) ||
              (oldData.collaboratorEmails.hasAll(newData.collaboratorEmails) &&
               newData.collaboratorEmails.size() >= oldData.collaboratorEmails.size() - 1 &&
               'email' in request.auth.token &&
               request.auth.token.email is string &&
               !(request.auth.token.email in newData.collaboratorEmails) &&
               !(request.auth.token.email.lower() in newData.collaboratorEmails) &&
               (!(oldData.ownerEmail.lower() in oldData.collaboratorEmails) ||
                oldData.ownerEmail.lower() in newData.collaboratorEmails)));
    }

    function isJoiningTrip(tripId, oldData, newData) {
      return !(request.auth.uid in oldData.memberUids) &&
             oldData.inviteCode is string &&
             oldData.inviteCode.size() >= 12 &&
             exists(/databases/$(database)/documents/tripInvites/$(oldData.inviteCode)) &&
             get(/databases/$(database)/documents/tripInvites/$(oldData.inviteCode)).data.tripId == tripId &&
             newData.diff(oldData).affectedKeys().hasOnly(['memberUids', 'collaboratorEmails', 'lastJoinProof', 'updatedAt']) &&
             'lastJoinProof' in newData &&
             newData.lastJoinProof == oldData.inviteCode + ':' + request.auth.uid &&
             request.auth.uid in newData.memberUids &&
             newData.memberUids.hasAll(oldData.memberUids) &&
             newData.memberUids.size() == oldData.memberUids.size() + 1 &&
             (!newData.diff(oldData).affectedKeys().hasAny(['collaboratorEmails']) ||
              (newData.collaboratorEmails.hasAll(oldData.collaboratorEmails) &&
               newData.collaboratorEmails.size() <= oldData.collaboratorEmails.size() + 1 &&
               'email' in request.auth.token &&
               request.auth.token.email is string &&
               (request.auth.token.email in newData.collaboratorEmails ||
                request.auth.token.email.lower() in newData.collaboratorEmails) &&
               newData.collaboratorEmails.removeAll(oldData.collaboratorEmails).hasOnly([request.auth.token.email, request.auth.token.email.lower()])));
    }

    function canAccessTrip(tripId) {
      return isAuthenticated() &&
             isTripDocCollaborator(get(/databases/$(database)/documents/trips/$(tripId)));
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidMember(data) {
      return hasOnlyAllowedFields(data, [
               'id', 'name', 'dietaryHabits', 'phone', 'passportInfo', 'notes',
               'groupId', 'tags', 'outboundFlight', 'outboundTime',
               'returnFlight', 'returnTime', 'isLeader', 'gender',
               'tripDays', 'carNumber'
             ]) &&
             hasRequiredFields(data, ['name']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             isValidOptionalString(data, 'dietaryHabits', 100) &&
             isValidOptionalString(data, 'phone', 30) &&
             isValidOptionalString(data, 'passportInfo', 200) &&
             isValidOptionalString(data, 'notes', 2000) &&
             isValidOptionalString(data, 'groupId', 100) &&
             isValidOptionalList(data, 'tags', 50) &&
             isValidOptionalString(data, 'outboundFlight', 100) &&
             isValidOptionalString(data, 'outboundTime', 100) &&
             isValidOptionalString(data, 'returnFlight', 100) &&
             isValidOptionalString(data, 'returnTime', 100) &&
             isValidOptionalBool(data, 'isLeader') &&
             isValidOptionalString(data, 'gender', 100) &&
             (!('tripDays' in data) || data.tripDays == null || (data.tripDays is number && data.tripDays >= 0 && data.tripDays <= 1000)) &&
             isValidOptionalString(data, 'carNumber', 100);
    }

    function isValidGroup(data) {
      return hasOnlyAllowedFields(data, ['id', 'name']) &&
             hasRequiredFields(data, ['name']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             (!('id' in data) || (data.id is string && data.id.size() <= 128));
    }

    function isValidSettings(data) {
      return hasOnlyAllowedFields(data, ['startDate', 'endDate', 'officialStartDate', 'dailyAbsences', 'adminEmails']) &&
             (!('startDate' in data) || (data.startDate is string && data.startDate.size() <= 30)) &&
             (!('endDate' in data) || (data.endDate is string && data.endDate.size() <= 30)) &&
             isValidOptionalString(data, 'officialStartDate', 30) &&
             isValidOptionalMap(data, 'dailyAbsences', 500) &&
             isValidOptionalList(data, 'adminEmails', 100);
    }

    function isValidItineraryLocation(loc) {
      return loc == null ||
             (loc is map &&
              loc.keys().hasOnly(['address', 'navLink']) &&
              isValidOptionalString(loc, 'address', 500) &&
              isValidOptionalString(loc, 'navLink', 1000));
    }

    function isValidSeatingConfig(config) {
      return config == null ||
             (config is map &&
              config.keys().hasOnly(['columns', 'rows']) &&
              (!('columns' in config) || (config.columns is number && config.columns >= 0 && config.columns <= 100)) &&
              (!('rows' in config) || (config.rows is number && config.rows >= 0 && config.rows <= 100)));
    }

    function isValidItinerary(data) {
      return hasOnlyAllowedFields(data, [
               'id', 'title', 'startTime', 'endTime', 'type', 'location',
               'notes', 'isMain', 'assignedMemberIds', 'excludedMemberIds',
               'dayIndex', 'vehicleAssignments', 'isMultiVehicle',
               'roomAssignments', 'isMultiRoom', 'rooms', 'seatingConfig',
               'seatingAssignments', 'seatingNotes',
               'groupAssignments', 'isGrouped', 'groups', 'accommodationDetail'
             ]) &&
             hasRequiredFields(data, ['title', 'startTime', 'type']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.startTime is timestamp &&
             (!('endTime' in data) || data.endTime == null || data.endTime is timestamp) &&
             data.type in ['attraction', 'dining', 'transit', 'logistics', 'accommodation'] &&
             (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             (!('isMain' in data) || data.isMain is bool) &&
             isValidOptionalString(data, 'notes', 2000) &&
             (!('location' in data) || isValidItineraryLocation(data.location)) &&
             isValidOptionalList(data, 'assignedMemberIds', 1000) &&
             isValidOptionalList(data, 'excludedMemberIds', 1000) &&
             (!('dayIndex' in data) || data.dayIndex == null || (data.dayIndex is number && data.dayIndex >= -1 && data.dayIndex <= 365)) &&
             isValidOptionalMap(data, 'vehicleAssignments', 1000) &&
             isValidOptionalBool(data, 'isMultiVehicle') &&
             isValidOptionalMap(data, 'roomAssignments', 1000) &&
             isValidOptionalBool(data, 'isMultiRoom') &&
             isValidOptionalList(data, 'rooms', 200) &&
             (!('seatingConfig' in data) || isValidSeatingConfig(data.seatingConfig)) &&
             isValidOptionalMap(data, 'seatingAssignments', 1000) &&
             isValidOptionalMap(data, 'seatingNotes', 1000) &&
             isValidOptionalMap(data, 'groupAssignments', 1000) &&
             isValidOptionalBool(data, 'isGrouped') &&
             isValidOptionalList(data, 'groups', 200) &&
             isValidOptionalString(data, 'accommodationDetail', 1000);
    }

    function isValidRollCall(data) {
      return hasOnlyAllowedFields(data, ['id', 'itineraryId', 'timestamp', 'statusMap']) &&
             hasRequiredFields(data, ['itineraryId', 'timestamp', 'statusMap']) &&
             (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             data.itineraryId is string && data.itineraryId.size() > 0 && data.itineraryId.size() <= 128 &&
             data.timestamp is timestamp &&
             data.statusMap is map && data.statusMap.size() <= 1000;
    }

    function isValidTripInvite(data) {
      return hasOnlyAllowedFields(data, ['tripId', 'tripName', 'ownerId', 'createdAt']) &&
             hasRequiredFields(data, ['tripId', 'tripName', 'ownerId', 'createdAt']) &&
             data.tripId is string && data.tripId.size() > 0 && data.tripId.size() <= 128 &&
             data.tripName is string && data.tripName.size() > 0 && data.tripName.size() <= 120 &&
             data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128 &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 40;
    }

    function isValidTrip(data) {
      return hasOnlyAllowedFields(data, [
               'id', 'name', 'description', 'startDate', 'endDate',
               'ownerId', 'ownerEmail', 'ownerName', 'memberUids',
               'collaboratorEmails', 'inviteCode', 'lastJoinProof',
               'createdAt', 'updatedAt'
             ]) &&
             hasRequiredFields(data, [
               'name', 'startDate', 'endDate', 'ownerId', 'ownerEmail',
               'memberUids', 'collaboratorEmails', 'inviteCode', 'createdAt'
             ]) &&
             (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             isValidOptionalString(data, 'description', 500) &&
             data.startDate is string && data.startDate.size() > 0 && data.startDate.size() <= 40 &&
             data.endDate is string && data.endDate.size() > 0 && data.endDate.size() <= 40 &&
             data.ownerId is string && data.ownerId.size() > 0 && data.ownerId.size() <= 128 &&
             data.ownerEmail is string && data.ownerEmail.size() > 0 && data.ownerEmail.size() <= 200 &&
             isValidOptionalString(data, 'ownerName', 120) &&
             data.memberUids is list && data.memberUids.size() <= 500 &&
             data.collaboratorEmails is list && data.collaboratorEmails.size() <= 500 &&
             data.inviteCode is string && data.inviteCode.size() >= 4 && data.inviteCode.size() <= 24 &&
             isValidOptionalString(data, 'lastJoinProof', 200) &&
             data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 40 &&
             isValidOptionalString(data, 'updatedAt', 40);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Legacy root collections locked down (data migrated to /trips/{tripId}/...)
    match /members/{memberId} {
      allow read, write: if false;
    }

    match /groups/{groupId} {
      allow read, write: if false;
    }

    match /settings/{docId} {
      allow read, write: if false;
    }

    match /itineraries/{itineraryId} {
      allow read, write: if false;
    }

    match /rollcalls/{rollcallId} {
      allow read, write: if false;
    }

    match /test/connection {
      allow read: if isAuthenticated();
    }

    match /tripInvites/{inviteCode} {
      allow get: if isAuthenticated() && inviteCode.size() >= 12 && inviteCode.size() <= 24;
      allow list: if false;
      allow create: if isAuthenticated() &&
                       inviteCode.size() >= 12 &&
                       inviteCode.size() <= 24 &&
                       isValidTripInvite(request.resource.data) &&
                       request.resource.data.ownerId == request.auth.uid &&
                       exists(/databases/$(database)/documents/trips/$(request.resource.data.tripId)) &&
                       get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.ownerId == request.auth.uid &&
                       get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.inviteCode == inviteCode;
      allow update: if false;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /trips/{tripId} {
      allow read: if isAuthenticated() && isTripCollaboratorData(resource.data);
      allow create: if isAuthenticated() &&
                       isValidTrip(request.resource.data) &&
                       request.resource.data.ownerId == request.auth.uid &&
                       request.auth.uid in request.resource.data.memberUids &&
                       request.resource.data.inviteCode.size() >= 12 &&
                       !('lastJoinProof' in request.resource.data);
      allow update: if isAuthenticated() &&
                       isValidTrip(request.resource.data) &&
                       request.resource.data.ownerId == resource.data.ownerId &&
                       request.resource.data.ownerEmail == resource.data.ownerEmail &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       (!('id' in resource.data) || request.resource.data.id == resource.data.id) &&
                       (isOwnerUpdatingTrip(resource.data, request.resource.data) ||
                        isCollaboratorEditingTripMetadata(resource.data, request.resource.data) ||
                        isCollaboratorLeavingTrip(resource.data, request.resource.data) ||
                        isJoiningTrip(tripId, resource.data, request.resource.data));
      allow delete: if isAuthenticated() &&
                       resource.data.ownerId == request.auth.uid;

      match /members/{memberId} {
        allow read, delete: if canAccessTrip(tripId);
        allow create, update: if canAccessTrip(tripId) && isValidMember(request.resource.data);
      }

      match /groups/{groupId} {
        allow read, delete: if canAccessTrip(tripId);
        allow create, update: if canAccessTrip(tripId) && isValidGroup(request.resource.data);
      }

      match /settings/{docId} {
        allow read, delete: if canAccessTrip(tripId);
        allow create: if canAccessTrip(tripId) &&
                         isValidSettings(request.resource.data) &&
                         !('adminEmails' in request.resource.data);
        allow update: if canAccessTrip(tripId) &&
                         isValidSettings(request.resource.data) &&
                         (!('adminEmails' in request.resource.data) ||
                          ('adminEmails' in resource.data && request.resource.data.adminEmails == resource.data.adminEmails));
      }

      match /itineraries/{itineraryId} {
        allow read, delete: if canAccessTrip(tripId);
        allow create, update: if canAccessTrip(tripId) && isValidItinerary(request.resource.data);
      }

      match /rollcalls/{rollcallId} {
        allow read, delete: if canAccessTrip(tripId);
        allow create, update: if canAccessTrip(tripId) && isValidRollCall(request.resource.data);
      }
    }
  }
}
